{
  "name": "pascal-toolchain",
  "version": "0.0.0",
  "private": true,
  "description": "A Pascal compiler frontend written in TypeScript: tokenizer, parser and code formatter.",
  "author": "Damian Sire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damiansire/pascal-toolchain.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "clean": "pnpm -r --filter \"./packages/*\" exec rimraf dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "typescript": "^5.6.3"
  }
}
