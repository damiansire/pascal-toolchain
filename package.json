{
  "name": "pascal-toolchain",
  "version": "0.0.0",
  "private": true,
  "description": "A Pascal compiler frontend written in TypeScript: tokenizer, parser and code formatter.",
  "author": "Damian Sire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damiansire/pascal-toolchain.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build -w pascal-tokenizer && npm run build -w pascal-parser && npm run build -w pascal-js-compiler && npm run build -w pascal-code-formatter",
    "test": "npm run test --workspaces --if-present",
    "test:types": "npm run test:types --workspaces --if-present",
    "size": "size-limit",
    "clean": "npm run clean --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@size-limit/preset-small-lib": "^12.1.0",
    "size-limit": "^12.1.0",
    "tsd": "^0.33.0",
    "typescript": "^5.6.3"
  }
}
