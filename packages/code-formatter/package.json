{
  "name": "pascal-code-formatter",
  "version": "0.0.4",
  "description": "A Pascal code formatter written in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:types": "tsd",
    "prepublishOnly": "npm run build && npm test"
  },
  "tsd": {
    "directory": "test-d"
  },
  "keywords": [
    "pascal",
    "formatter",
    "code",
    "tokenizer",
    "typescript",
    "javascript"
  ],
  "author": "Damian Sire",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "counterweight-stack": "0.0.1",
    "pascal-parser": "^0.2.1",
    "pascal-tokenizer": "^0.0.3"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damiansire/pascal-toolchain.git",
    "directory": "packages/code-formatter"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/damiansire/pascal-toolchain/issues"
  },
  "homepage": "https://github.com/damiansire/pascal-toolchain/tree/main/packages/code-formatter#readme",
  "files": [
    "dist"
  ]
}
