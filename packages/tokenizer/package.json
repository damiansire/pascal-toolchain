{
  "name": "pascal-tokenizer",
  "version": "0.0.3",
  "description": "A tokenizer for Pascal programming language",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch --coverage",
    "test:types": "tsd",
    "prepublishOnly": "npm run build && npm test"
  },
  "tsd": {
    "directory": "test-d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damiansire/pascal-toolchain.git",
    "directory": "packages/tokenizer"
  },
  "bugs": {
    "url": "https://github.com/damiansire/pascal-toolchain/issues"
  },
  "homepage": "https://github.com/damiansire/pascal-toolchain/tree/main/packages/tokenizer#readme",
  "keywords": [
    "pascal",
    "tokenizer",
    "lexer",
    "parser",
    "compiler"
  ],
  "author": "Damian Sire",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "files": [
    "dist"
  ]
}
